# Copy to .env (never commit .env). Both devs use the SAME values except where noted.

# ---- servers (bind to localhost only: sovereign rule)
WB_API_HOST=127.0.0.1
WB_API_PORT=8000
WB_MOCK_PORT=8001
# UI talks to this. Track B dev: 8001 (mock). After integration: 8000 (real).
WB_API_URL=http://127.0.0.1:8001
WB_UI_PORT=8501
WB_MOCK=false

# ---- model server
OLLAMA_HOST=http://127.0.0.1:11434
WB_MODELS_FILE=config/models.yaml
WB_NUM_CTX=8192
WB_TEMPERATURE=0.2
WB_THINK=false
WB_LLM_TIMEOUT_S=180
WB_LLM_RETRIES=1

# ---- agent limits
WB_AGENT_MAX_STEPS=8
WB_AGENT_TIMEOUT_S=600
WB_CODE_MAX_ATTEMPTS=3

# ---- paths (relative to repo root)
WB_WORKSPACE_DIR=workspace
WB_KB_DIR=data/kb
WB_CHROMA_DIR=data/chroma
WB_CACHE_DIR=data/cache
WB_LOG_DIR=logs
WB_TEMPLATES_DIR=templates
WB_MAX_UPLOAD_MB=25

# ---- OCR / vision
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
WB_OCR_DPI=200
WB_VISION_MAX_PX=1024
WB_PID_TILES=4

# ---- sandbox
WB_SANDBOX_IMAGE=wb-sandbox:1.0
WB_SANDBOX_TIMEOUT_S=30
WB_SANDBOX_MEM=512m
WB_SANDBOX_CPUS=1

# ---- network monitor
WB_NET_POLL_S=1

# ---- kill all library telemetry / online lookups (sovereign proof depends on this)
ANONYMIZED_TELEMETRY=False
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
DO_NOT_TRACK=1
